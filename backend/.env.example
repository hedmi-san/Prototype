# Server Port
PORT=8080

# PostgreSQL Connection Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=root
PGDATABASE=distributor_db

# Or use connection string:
# DATABASE_URL=postgres://postgres:root@localhost:5432/distributor_db

# Security
JWT_SECRET=super-secret-jwt-key-for-tool-distributor-app
JWT_EXPIRES_IN=24h
